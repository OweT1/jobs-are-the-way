ENVIRONMENT_NAME=DEV

# OpenRouter API Key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional extra OpenRouter keys (comma-separated) used as fallbacks/rotation.
# Falls back to OPENROUTER_API_KEY if empty.
OPENROUTER_API_KEYS=

# HuggingFace API Key
HF_API_KEY=
HF_BASE_URL=https://router.huggingface.co/v1
# Optional extra HuggingFace keys (comma-separated) used as fallbacks/rotation.
HF_API_KEYS=

# JobSpy Variables
DEFAULT_LOCATION=Singapore

